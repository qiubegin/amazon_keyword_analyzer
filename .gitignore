# Python cache and build artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
build/
dist/

# Virtual environments
.venv/
venv/
env/
ENV/

# Secrets and local configuration
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx

# IDE and OS files
.idea/
.vscode/
.jbeval/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.DS_Store
Thumbs.db

# Logs and local runtime files
*.log
*.pid

# Large/local datasets: synchronize separately for deployment
raw_data/**/*.csv
raw_data/**/*.xlsx
processed_data/**/*.csv
processed_data/**/*.xlsx

# Keep directory placeholders if they are added later
!raw_data/.gitkeep
!processed_data/.gitkeep
